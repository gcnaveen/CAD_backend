{
  "name": "cad-backend-api",
  "version": "1.0.0",
  "description": "CAD Backend API - Serverless (AWS Lambda + HTTP API)",
  "main": "src/handlers/authApi.js",
  "private": true,
  "scripts": {
    "dev": "serverless offline start",
    "postinstall": "node -e \"try{require('pg-sdk-node'); console.log('pg-sdk-node: OK');}catch(e){console.error('pg-sdk-node: BROKEN INSTALL'); console.error(e && e.message ? e.message : e); process.exit(1)}\"",
    "deploy": "node scripts/deploy-with-identity.js --stage dev",
    "deploy:dev": "node scripts/deploy-with-identity.js --stage dev",
    "deploy:prod": "node scripts/deploy-with-identity.js --stage prod",
    "build:identity": "node scripts/write-build-identity.js",
    "info": "serverless info",
    "info:dev": "serverless info --stage dev",
    "info:prod": "serverless info --stage prod",
    "invoke:test": "serverless invoke local -f authApi -d '{\"routeKey\":\"GET /api/health\",\"requestContext\":{\"http\":{\"method\":\"GET\",\"path\":\"/api/health\"}},\"rawPath\":\"/api/health\"}'",
    "seed:tno": "node tno/seed-districts-taluks-hoblis.js",
    "seed:tno:dry-run": "node tno/seed-districts-taluks-hoblis.js --dry-run",
    "test:c02": "node scripts/c02-download-entitlement-acceptance.js",
    "test:payment-model": "node scripts/c02-payment-state-model-acceptance.js",
    "test:h02": "node scripts/h02-auth-hardening-acceptance.js",
    "test:h03": "node scripts/h03-dependency-sca-acceptance.js",
    "test:h04": "node scripts/h04-ci-acceptance.js",
    "test:h05": "node scripts/h05-release-provenance-acceptance.js",
    "test:h06": "node scripts/h06-architecture-adr-acceptance.js",
    "test:h07": "node scripts/h07-file-safeguards-acceptance.js",
    "test:h08": "node scripts/h08-public-claims-acceptance.js",
    "test:h09": "node scripts/h09-ownership-handover-acceptance.js",
    "test:h10": "node scripts/h10-upload-auth-acceptance.js",
    "test:h11": "node scripts/h11-cad-payout-acceptance.js",
    "test:h12": "node scripts/h12-cad-deliverable-acceptance.js",
    "test:biz09": "node scripts/biz09-sketch-pricing-contract-acceptance.js",
    "test:biz10": "node scripts/biz10-payment-gate-acceptance.js",
    "test:refund-policy": "node scripts/refund-policy-acceptance.js",
    "test:m01": "node scripts/m01-cors-security-acceptance.js",
    "test:m02": "node scripts/m02-token-storage-acceptance.js",
    "test:m03": "node scripts/m03-route-role-acceptance.js",
    "test:m05": "node scripts/m05-performance-acceptance.js",
    "test:m06": "node scripts/m06-login-a11y-acceptance.js",
    "test:m07": "node scripts/m07-observability-acceptance.js",
    "test:m08": "node scripts/m08-lifecycle-qc-acceptance.js",
    "test:m09": "node scripts/m09-auto-assign-acceptance.js",
    "test:m10": "node scripts/m10-sla-due-acceptance.js",
    "test:m12": "node scripts/m12-session-refresh-acceptance.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:acceptance": "npm run test:c02 && npm run test:payment-model && npm run test:h02 && npm run test:h03 && npm run test:h04 && npm run test:h05 && npm run test:h06 && npm run test:h07 && npm run test:h08 && npm run test:h09 && npm run test:h10 && npm run test:h11 && npm run test:h12 && npm run test:biz09 && npm run test:biz10 && npm run test:refund-policy && npm run test:m01 && npm run test:m02 && npm run test:m03 && npm run test:m05 && npm run test:m06 && npm run test:m07 && npm run test:m08 && npm run test:m09 && npm run test:m10 && npm run test:m12",
    "test": "npm run test:unit && npm run test:acceptance",
    "lint": "node scripts/lint-syntax.js",
    "sbom": "node scripts/generate-sbom.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "arch:indexes": "node scripts/list-schema-indexes.js",
    "retention:purge": "node scripts/retention-purge.js --dry-run",
    "migrate:user-roles": "node scripts/migrate-normalize-user-roles.js"
  },
  "keywords": [
    "serverless",
    "aws",
    "lambda"
  ],
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "js-yaml": "4.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "pg-sdk-node": "2.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "serverless": "^3.40.0",
    "serverless-offline": "^13.3.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "form-data": "4.0.6",
    "follow-redirects": "1.16.0",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.1",
    "velocityjs": "2.1.7",
    "@hapi/content": "6.0.2",
    "simple-git": "3.36.0",
    "adm-zip": "0.6.0",
    "ws": "8.21.1",
    "fast-uri": "3.1.5",
    "brace-expansion": "5.0.9",
    "tar": "7.5.22"
  }
}
