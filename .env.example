# Copy to .env and fill from Secrets Manager / password manager (audit H-01).
# Never commit real secrets. Never put JWT_SECRET in frontend code.

JWT_EXPIRES_IN=24h
JWT_SECRET=                    # required: openssl rand -base64 48 (≥32 chars, not a banned default)
MONGODB_URI=
MONGODB_URI_STANDARD=
MONGODB_DISCOVER_PRIMARY=false
NODE_ENV=development
STAGE=dev

OTP_TEST_MODE=false
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE_NAME=number
MSG91_SMS_ROUTE=4
MSG91_SENDER_ID=

S3_BUCKET=                 # required — no code/serverless default (audit H-06)
PUBLIC_API_BASE_URL=

# H-10 upload presign (auth + size always enforced in code)
UPLOAD_REQUIRE_AUTH=true
UPLOAD_REQUIRE_SIZE=true
UPLOAD_PRESIGN_MAX_EXPIRES_SECONDS=900
UPLOAD_PRESIGN_MAX_PER_WINDOW=40
UPLOAD_PRESIGN_WINDOW_MS=900000
UPLOAD_PRESIGN_LOCKOUT_MS=900000
UPLOAD_DAILY_FILE_QUOTA=100
UPLOAD_DAILY_BYTE_QUOTA=524288000
CLAMAV_SCAN_URL=
WATERMARK_REQUIRED=true
FILE_RETENTION_DAYS=365
CAD_DOWNLOAD_URL_TTL_SECONDS=120


# Prefer PHONEPE_* names (CLIENT_* aliases still work but deprecate)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX          # must be PRODUCTION on prod stage
PHONEPE_SUCCESS_REDIRECT_URL=https://example.com/dashboard/user
PHONEPE_FAILURE_REDIRECT_URL=https://example.com/dashboard/user

SKETCH_UPLOAD_FEE_PAISE=0
SKETCH_REVISION_FEE_PAISE=0
SKETCH_BALANCE_FEE_PAISE=40000
CAD_DOWNLOAD_URL_TTL_SECONDS=120
# H-11 fixed CAD payout (₹400 on ₹500 order) — do not use CAD_PAYOUT_PERCENT
CAD_PAYOUT_RULE_VERSION=CAD_PAYOUT_V1_FIXED_400
CAD_OPERATOR_PAYOUT_PAISE=40000
CAD_PAYOUT_GROSS_PAISE=50000
CAD_PAYOUT_BOOKING_PAISE=10000
CAD_PAYOUT_BALANCE_PAISE=40000
CAD_PAYOUT_PLATFORM_FEE_PAISE=10000
CAD_PAYOUT_TAX_PAISE=0
CAD_PAYOUT_ADJUSTMENT_PAISE=0
CAD_REVISION_OPERATOR_PAYOUT_PAISE=0
PAYMENT_ATTEMPT_EXPIRE_MS=86400000

CAD_INTEREST_ENABLED=true

# H-12 CAD deliverable
CAD_SOURCE_MAX_BYTES=52428800
CAD_PREVIEW_MAX_BYTES=15728640
CAD_DELIVERABLE_REQUIRE_CONFIRM=true
CAD_MULTIPART_PART_SIZE_BYTES=8388608

# M-01 CORS (comma-separated; never *). Must include real FE origins (e.g. https://north-cot.com).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://north-cot.com,https://www.north-cot.com
PUBLIC_FRONTEND_ORIGIN=https://north-cot.com

# M-02 session cookies (FE: memory access token + HttpOnly refresh)
AUTH_USE_REFRESH_COOKIE=true
AUTH_OMIT_REFRESH_IN_BODY=false
# Cross-origin API (execute-api) → use None + Secure; same-site API host can use Lax
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=true
# JWT_ACCESS_EXPIRES_IN=15m # recommend when FE ships memory-only access
